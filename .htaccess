# Prestij Nakliyat — Apache (cPanel) ayarları. GitHub Actions ile sitenin belge köküne yüklenir.
# Yalnızca bu sitenin belge kökünde kalmalıdır; başka bir sitenin klasörüne kopyalamayın.

Options -Indexes
DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Tek adres: https + www'suz (sayfalardaki canonical ile aynı).
  RewriteCond %{HTTPS} !=on [OR]
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteRule ^ https://prestijevdenevenakliyat.com%{REQUEST_URI} [R=301,L]

  # /index.html → / (yinelenen ana sayfa adresi olmasın).
  RewriteCond %{THE_REQUEST} \s/+index\.html[\s?] [NC]
  RewriteRule ^index\.html$ / [R=301,L]
</IfModule>

# Yükleme aracının durum dosyası ve gizli dosyalar dışarıya kapalı.
<FilesMatch "^(\.ftp-deploy-sync-state\.json|\.ht.*|\.git.*)$">
  Require all denied
</FilesMatch>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  # HTML her ziyarette yeniden doğrulanır. CSS/JS ?v= ile sürümlendiği için 1 yıl önbellekte kalır;
  # görsel ve fontlar sürümsüz adreslerle kullanıldığından 30 gün (aynı adla değiştirilen dosya en geç 30 günde yenilenir).
  <FilesMatch "\.(html|xml|txt)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(png|jpe?g|webp|avif|svg|ico|ttf|woff2?)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/xml application/javascript image/svg+xml font/ttf
</IfModule>

<IfModule mod_mime.c>
  AddType font/ttf .ttf
  AddType font/woff2 .woff2
  AddType image/webp .webp
  AddType image/avif .avif
</IfModule>
